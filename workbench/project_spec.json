{
  "project": {
    "name": "System Resource Monitor",
    "version": "1.0.0",
    "type": "system-monitoring-tool"
  },
  "monitored_resources": {
    "selected": [
      {
        "name": "CPU",
        "enabled": true,
        "priority": "high",
        "metrics": [
          "overall_usage_percent",
          "per_core_usage",
          "load_average",
          "frequency_mhz"
        ]
      },
      {
        "name": "Memory",
        "enabled": true,
        "priority": "high",
        "metrics": [
          "total_bytes",
          "used_bytes",
          "available_bytes",
          "swap_usage",
          "cache_bytes"
        ]
      },
      {
        "name": "Disk",
        "enabled": true,
        "priority": "high",
        "metrics": [
          "partition_usage",
          "io_read_bytes",
          "io_write_bytes",
          "io_read_count",
          "io_write_count"
        ]
      },
      {
        "name": "Network",
        "enabled": true,
        "priority": "medium",
        "metrics": [
          "bytes_sent",
          "bytes_received",
          "packets_sent",
          "packets_received",
          "errors_in",
          "errors_out",
          "drops_in",
          "drops_out",
          "active_connections"
        ]
      },
      {
        "name": "Processes",
        "enabled": true,
        "priority": "medium",
        "metrics": [
          "total_count",
          "running_count",
          "sleeping_count",
          "zombie_count",
          "top_cpu_processes",
          "top_memory_processes"
        ]
      }
    ],
    "excluded": [
      {
        "name": "GPU",
        "reason": "Not universally available across target systems"
      },
      {
        "name": "Hardware Sensors",
        "reason": "Hardware-specific, limited general applicability"
      },
      {
        "name": "Peripherals",
        "reason": "Outside monitoring scope"
      }
    ]
  },
  "requirements": {
    "functional": 5,
    "non_functional": 5,
    "technical": 3
  },
  "platforms": ["linux", "macos", "windows"],
  "language": "python",
  "python_version": ">=3.9"
}
